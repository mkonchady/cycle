def capitalize(instr):
    parts = instr.lower().split(" ")
    outstr = ""
    for part in parts:
        if len(part) == 3:
            if part == "and":
                outstr = outstr + part + " "
            else:
                outstr = outstr + part.upper() + " "
        else:
            part = part.lstrip('-')
            if (len(part) > 2):
                outstr = outstr + part[0].upper() + part[1:] + " "
    return outstr.strip()


#*-- build the list of spreadsheets in the directory
def build_flist(DIR):
    flist = []
    for file in os.listdir(DIR):
        if file.endswith('.xlsx'):
            flist.append(file)
    return (flist)

